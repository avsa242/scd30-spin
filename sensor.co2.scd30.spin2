#include "sensor.co2.common.spin2h"
#include "sensor.temp.common.spin2h"
#include "sensor.rh.common.spin2h"

CON

    { default I/O settings; these can be overridden in the parent object }
    SCL             = 0
    SDA             = 1
    I2C_FREQ        = 100_000
    I2C_ADDR        = 0

    SLAVE_WR        = core.SLAVE_ADDR
    SLAVE_RD        = core.SLAVE_ADDR|1

    I2C_MAX_FREQ    = core.I2C_MAX_FREQ

' Operating modes
    STANDBY         = 0
    CONT            = 1

' Error codes
    EBADCRC         = $E000_0C0C

' Temperature scales
    C               = 0
    F               = 1


VAR

    long _co2
    long _temp
    long _rh
    word _presscomp
    byte _opmode


OBJ

    i2c:    "com.i2c"                           ' I2C engine
    core:   "core.con.scd30"                    ' hw-specific constants
    crc:    "math.crc"                          ' CRC routines
    fm:     "math.float.nocog"                  ' IEEE-754 float functions


PUB null()
' This is not a top-level object


PUB start(): status
' Start using "standard" Propeller I2C pins and 100kHz
    return startx(SCL, SDA, I2C_FREQ)


PUB startx(SCL_PIN, SDA_PIN, I2C_HZ): status
' Start using custom IO pins and I2C bus frequency
    if ( lookdown(SCL_PIN: 0..63) and lookdown(SDA_PIN: 0..63) )
        if ( status := i2c.init(SCL_PIN, SDA_PIN, I2C_HZ) )
            waitus(core.T_POR)                  ' wait for device startup
            if ( present() )
                return
    ' if this point is reached, something above failed
    ' Re-check I/O pin assignments, bus speed, connections, power
    ' Lastly - make sure you have at least one free core/cog 
    return FALSE


PUB stop()
' Stop the driver
    i2c.deinit()
    longfill(@_co2, 0, 3)
    bytefill(@_presscomp, 0, 3)


PUB defaults()
' Set factory defaults
    reset()


PUB preset_active()
' Like defaults(), but sets continuous measurement mode, with 2sec interval
    reset()
    opmode(CONT)
    meas_interval(2)


PUB present(): p
' Test device bus presence
    p := 0
    i2c.start()
    p := i2c.write(SLAVE_WR)
    i2c.stop()                                  ' P: SCD30 doesn't support Sr
    return (p == i2c.ACK)                       ' return TRUE if present


PUB adc2co2(w): c
' Convert ADC word to CO2 data
    return fm.ftrunc( fm.fmul(w, 10.0) )


PUB co2_alt_comp(): c
' Get altitude compensation value
'   Returns: meters
    return readreg(core.ALTITUDECOMP, 1)


PUB co2_set_alt_comp(a)
' Compensate CO2 measurements based on altitude, in meters
'   Valid values: 0..65535 (clamped to range)
'   NOTE: This setting is disregarded when ambient pressure is set
'   NOTE: This setting is stored in the sensor in non-volatile memory,
'       i.e., it will save even if power is lost
    writereg(core.ALTITUDECOMP, (0 #> a <# 65535), 3)


PUB co2_amb_press_comp(p): c
' Get ambient pressure compensation value (MCU RAM)
'   Returns: millibars
    return _presscomp


PUB co2_set_amb_press_comp(p)
' Set ambient pressure, in millibars, for use in on-sensor compensation (MCU RAM)
'   Valid values:
'       0: disable compensation
'       700..1400 (clamped to range)
'   NOTE: To effect settings, opmode(CONT) must be called
    _presscomp := (700 #> p <# 1400)


PUB auto_cal_ena(s=-2): c
' Enable automatic self-calibration
'   Valid values: TRUE (-1 or 1), *FALSE (0)
'   Any other value polls the chip and returns the current setting
'   NOTE: This process requires the following in order to be successful:
'       1) The sensor must be powered continuously for a minimum of 7 days
'           (if power is removed, the process will abort and must be restarted)
'       2) The sensor should be exposed to fresh air for approx 1 hr every day
'       3) The sensor must be set to continuous measurement mode
'   NOTE: The calibration result is saved in non-volatile memory,
'       i.e., it will save even if power is lost (after completion)
    case abs(s)
        0, 1:
            writereg(core.AUTOSELFCAL, abs(s), 3)
        other:
            return ( readreg(core.AUTOSELFCAL, 1) == 1 )


PUB co2_bias(b=-2): c
' Manually set calibration/reference level of CO2 sensor
'   Valid values: 400..2000
'   Any other value polls the chip and returns the current setting
'   NOTE: The calibration value is saved in volatile memory,
'       i.e., it will not save if power is lost
    case b
        400..2000:
            writereg(core.SETRECALVAL, b, 3)
        other:
            c := readreg(core.SETRECALVAL, 1)
            return c


PUB co2_data(): d
' CO2 data
'   Returns: IEEE-754 float
    if ( co2_data_rdy() )
        read_meas()
    else
        return _co2


PUB co2_data_rdy(): f
' Flag indicating data ready
    f := readreg(core.GETDRDY, 1)
    return ( (f & 1) == 1 )


PUB measure()
' dummy method


PUB meas_interval(i=-2): c
' Set measurement interval, in seconds
'   Valid values: 2..1800
'   Any other value returns the current setting
    case i
        2..1800:
            writereg(core.SETMEASINTERV, i, 3)
        other:
            return readreg(core.SETMEASINTERV, 1)


PUB opmode(m=-2): c
' Set operating mode
'   Valid values:
'      *STANDBY (0): stop measuring
'       CONT (1): continuous measurement
'   Any other value returns the current setting
    case m
        CONT:
            writereg(core.CONTMEAS, _presscomp, 2)
        STANDBY:
            command(core.STOPMEAS)
        other:
            return _opmode
    _opmode := m


PUB reset()
' Reset the device
    command(core.SOFTRESET)
    waitus(core.T_RES)


PUB rh_data(): d
' Relative humidity data
'   Returns: IEEE-754 float
    if ( co2_data_rdy() )
        read_meas()
    else
        return _rh


PUB rh_word2pct(w): r
' Convert ADC word to RH data
    return fm.ftrunc( fm.fmul(w, 100.0) )


PUB temp_data(): d
' Temperature data
'   Returns: IEEE-754 float
    if ( co2_data_rdy() )
        read_meas()
    else
        return _temp


PUB temp_word2deg(w): t
' Convert ADC word to temperature data
    return fm.ftrunc(fm.fmul(w, 100.0) )


PUB version(): v
' Firmware version
'   Returns: word [MSB:major..LSB:minor]
'   Known values: $03_42
    return readreg(core.FWVER, 1)


PRI read_meas(): s | meas_tmp[3]
' Read measurements and cache in RAM
'   NOTE: Valid data will be returned only if the data_rdy() signal is TRUE
    longfill(@meas_tmp, 0, 3)
    s := readreg(core.READMEAS, 6, @meas_tmp)
    if ( s == 0 )                               ' status good? update the measurements in RAM
        _co2 := (meas_tmp.word[0] << 16) | meas_tmp.word[1]
        _temp := (meas_tmp.word[2] << 16) | meas_tmp.word[3]
        _rh := (meas_tmp.word[4] << 16) | meas_tmp.word[5]
    else
        return                                  ' pass through the error from readreg


PRI readreg(reg_nr, len, p_dest=0): v | cmd_pkt, tmp, crc_tmp, rd_wd, last_wd
' Read register value(s)
'   reg_nr:     register number
'   len:        length/number of 16-bit words to read
'   p_dest:     pointer to destination buffer (only used if reg_nr == READMEAS)
'   Returns:    value stored in register (only used if reg_nr <> READMEAS)
    cmd_pkt.byte[0] := SLAVE_WR
    cmd_pkt.byte[1] := reg_nr.byte[1]
    cmd_pkt.byte[2] := reg_nr.byte[0]
    i2c.start()
    i2c.wrblock_lsbf(@cmd_pkt, 3)
    i2c.stop()                                  ' P: SCD30 doesn't support Sr

    waitus(core.T_WRRD)                         ' wait between write and read

    i2c.start()
    i2c.wr_byte(SLAVE_RD)


    last_wd := (len-1)
    repeat rd_wd from 0 to last_wd
        tmp := i2c.rdword_msbf(i2c.ACK)
        crc_tmp := i2c.rd_byte(rd_wd == last_wd)' send ACK until reaching the last data
        if ( crc.sensirion_crc8(@tmp, 2) == crc_tmp )
            if ( reg_nr == core.READMEAS )
                word[p_dest] := tmp        ' data is good - copy it to the caller
                p_dest += 2
            else
                v := tmp
        else
            i2c.stop()
            return EBADCRC                      ' data read failed CRC
    i2c.stop()


PRI command = writereg
PRI writereg(reg_nr, val=0, len=1) | cmd_pkt, dat_tmp, crc_tmp
' Write value to register
'   reg_nr:     register number
'   val:        value to write (optional; default is 0)
'   len:        length/number of bytes to write (optional; default is 1)
    cmd_pkt.byte[0] := SLAVE_WR
    cmd_pkt.byte[1] := reg_nr.byte[1]
    cmd_pkt.byte[2] := reg_nr.byte[0]
    i2c.start()
    i2c.wrblock_lsbf(@cmd_pkt, 3)

    case reg_nr
        core.CONTMEAS, core.SETMEASINTERV, core.ALTITUDECOMP, core.SETRECALVAL, ...
        core.AUTOSELFCAL, core.SETTEMPOFFS:
            dat_tmp := val
            dat_tmp <<= 8
            crc_tmp := dat_tmp.byte[1]
            dat_tmp.byte[0] := crc.sensirion_crc8(@crc_tmp, 2)
            i2c.wrblock_msbf(@dat_tmp, len)

    i2c.stop()

DAT
